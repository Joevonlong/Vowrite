{
  "description": "Vowrite product policy hooks. The canonical guard is stored in this repository so standalone clones and linked worktrees fail closed.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/branch-guard.sh\"",
            "statusMessage": "Vowrite worktree branch policy"
          }
        ]
      }
    ]
  }
}
