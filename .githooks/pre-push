#!/usr/bin/env bash
# Reject direct pushes; agent-task publish or an explicit release context owns publication.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
GUARD="$REPO_ROOT/.agents/hooks/branch-guard.sh"

if [[ ! -x "$GUARD" ]]; then
    echo "Missing executable canonical guard: $GUARD" >&2
    exit 2
fi

exec "$GUARD" --pre-push "$@"
